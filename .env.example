# ============================================================
# Example environment config. Copy to .env and fill in.
# NEVER commit a real .env. Secrets (authority keypair) live
# ONLY on the backend, never in the game/web-shell bundle.
# ============================================================

# --- Cluster / RPC ---
# devnet first; switch to a paid RPC (Helius/Triton/QuickNode) for writes
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# --- Public program / mint addresses (safe to expose to client) ---
LEADERBOARD_PROGRAM_ID=
REWARD_DISTRIBUTOR_PROGRAM_ID=
PVP_BETTING_PROGRAM_ID=
REWARD_TOKEN_MINT=

# --- Frontend (VITE_ prefix is exposed to the browser bundle) ---
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_BACKEND_URL=http://localhost:8080

# ============================================================
# BACKEND ONLY — never prefixed with VITE_, never shipped to client
# ============================================================
# Path to the authority keypair file, OR a KMS reference in prod.
# This key holds mint/leaderboard authority. Treat as a production secret.
AUTHORITY_KEYPAIR_PATH=./authority-keypair.json
BACKEND_PORT=8080
DATABASE_URL=postgres://localhost:5432/monkeysaga
# Session nonce signing secret (HMAC)
SESSION_SECRET=change-me-in-prod
